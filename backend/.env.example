# Configurações de Banco de Dados
DATABASE_URL="postgresql://user:***@host:port/dbname?sslmode=require"
# Opcional (apenas se usar Prisma Migrate localmente com shadow db)
# DIRECT_URL="postgresql://user:***@host:port/dbname?sslmode=require"

# Segurança
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="gere-uma-chave-de-64-caracteres-hex"

# Email — Opção 1: Resend (recomendado, API-based)
# 1. Crie conta em https://resend.com (grátis, 100 emails/dia)
# 2. Adicione o domínio e verifique os DNS records
# 3. Gere uma API key em https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxx"
# Remetente: use email do domínio verificado no Resend
EMAIL_FROM="Finanza <noreply@finanzaai.tech>"

# Email — Opção 2: SMTP (fallback, para Hostinger/Gmail/etc)
# SMTP_HOST="smtp.hostinger.com"
# SMTP_PORT="465"
# SMTP_USER="noreply@finanzaai.tech"
# SMTP_PASS="sua-senha"
# EMAIL_FROM="Finanza <noreply@finanzaai.tech>"

# Se Resend estiver configurado, SMTP é usado como fallback automático

# Inteligência Artificial (OpenRouter)
# Obtenha sua chave em: https://openrouter.ai/keys
OPENROUTER_API_KEY="***"

# Configurações de IA (Opcional - Possui Fallback)
AI_TEXT_MODEL="google/gemini-2.0-flash-exp:free"
AI_VISION_MODEL="google/gemini-2.0-flash-exp:free"

# Frontend
FRONTEND_URL="http://localhost:5173"

# Mercado Pago
# 1. Crie conta em https://mercadopago.com.br (aceita PF)
# 2. Vá em Configurações > Credenciais > Access Token (Produção ou Teste)
# 3. Para testes: use o Access Token do ambiente Sandbox
# 4. Configure o Webhook URL no painel do Mercado Pago:
#    https://api.finanzaai.tech/v1/payments/webhook (produção)
#    https://seu-ngrok-url/v1/payments/webhook (dev local)
MERCADOPAGO_ACCESS_TOKEN="TEST-XXXX" ou "APP_USR-XXXX"
MERCADOPAGO_WEBHOOK_URL="https://api.finanzaai.tech/v1/payments/webhook"

# Planos e preços (opcional - defaults no código)
# PREMIUM_MONTHLY_PRICE=19.90
# PREMIUM_ANNUAL_PRICE=179.90NODE_ENV=production
MERCADOPAGO_WEBHOOK_SECRET=your_webhook_secret_here
