# Configurações de Banco de Dados
DATABASE_URL="postgresql://user:***@host:port/dbname?sslmode=require"
# Opcional (apenas se usar Prisma Migrate localmente com shadow db)
# DIRECT_URL="postgresql://user:***@host:port/dbname?sslmode=require"

# Segurança
JWT_SECRET="sua-chave-secreta-aqui-minimo-32-caracteres"

# Email (Resend — https://resend.com)
# Crie uma conta gratuita (100 emails/dia) e obtenha sua API key
RESEND_API_KEY="re_xxxxxxxxxxxx"
# Email de remetente — use o domínio verificado no Resend
# Domínio padrão do Resend para testes: onboarding@resend.dev
RESEND_FROM_EMAIL="Finanza <onboarding@resend.dev>"

# Inteligência Artificial (OpenRouter)
# Obtenha sua chave em: https://openrouter.ai/keys
OPENROUTER_API_KEY="***"

# Configurações de IA (Opcional - Possui Fallback)
AI_TEXT_MODEL="google/gemini-2.0-flash-exp:free"
AI_VISION_MODEL="google/gemini-2.0-flash-exp:free"

# Frontend
FRONTEND_URL="http://localhost:5173"
