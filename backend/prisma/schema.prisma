generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  // DIRECT_URL is optional - only required for Neon serverless with connection pooling
}

model User {
  id                         String                      @id @default(uuid())
  email                      String                      @unique
  emailHash                  String                      @unique
  password                   String
  name                       String?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  isAdmin                    Boolean                     @default(false)
  isEmailVerified            Boolean                     @default(false)
  hashedRefreshToken         String?
  failedLoginAttempts        Int                         @default(0)
  lockedUntil                DateTime?
  termsAccepted              Boolean                     @default(false)
  termsAcceptedAt            DateTime?
  accounts                   Account[]
  budgets                    Budget[]
  categories                 Category[]
  creditCards                CreditCard[]
  feedbacks                  Feedback[]
  goals                      Goal[]
  importedFitIds             ImportedFitId[]
  notifications              Notification[]
  transactions               Transaction[]
  receivedInvites            TransactionInvite[]         @relation("ReceivedInvites")
  sentInvites                TransactionInvite[]         @relation("SentInvites")
  verificationTokens         VerificationToken[]
  subscription               Subscription?
  aiRequestLogs              AiRequestLog[]
  auditLogs                  AuditLog[]
  recurringTransactions      RecurringTransaction[]
  creditCardInstallments     CreditCardInstallment[]
  creditCardInvoices         CreditCardInvoice[]
  payments                   Payment[]
  refreshTokens              RefreshToken[]
  createdResellers           Reseller[]                  @relation("ResellerCreatedByAdmin")
  resellerLedgerEntries      ResellerLedger[]            @relation("ResellerLedgerCreatedByAdmin")
  resellerPremiumActivations ResellerPremiumActivation[] @relation("ResellerPremiumActivationTarget")
}

model Account {
  id                     String                  @id @default(uuid())
  name                   String
  type                   String
  balance                String                  @default("0")
  userId                 String
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  version                Int                     @default(0)
  deletedAt              DateTime? // Soft delete
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditCards            CreditCard[]
  transactions           Transaction[]
  recurringTransactions  RecurringTransaction[]
  creditCardInstallments CreditCardInstallment[]

  @@index([userId])
  @@index([userId, deletedAt])
}

model CreditCard {
  id                   String                  @id @default(uuid())
  name                 String
  limit                String
  closingDay           Int
  dueDay               Int
  accountId            String?
  userId               String
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  version              Int                     @default(0)
  deletedAt            DateTime? // Soft delete
  account              Account?                @relation(fields: [accountId], references: [id], onDelete: SetNull)
  user                 User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions         Transaction[]
  invoices             CreditCardInvoice[]
  installments         CreditCardInstallment[]
  RecurringTransaction RecurringTransaction[]

  @@index([userId])
  @@index([userId, deletedAt])
  @@index([accountId])
}

model Category {
  id                     String                  @id @default(uuid())
  name                   String
  color                  String?
  icon                   String?
  type                   String
  userId                 String
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  deletedAt              DateTime? // Soft delete
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions           Transaction[]
  budgets                Budget[]
  recurringTransactions  RecurringTransaction[]
  creditCardInstallments CreditCardInstallment[]

  @@index([userId])
  @@index([userId, deletedAt])
}

model Transaction {
  id                 String                 @id @default(uuid())
  description        String
  amount             String
  date               DateTime
  categoryLegacy     String?                @map("category")
  type               String
  isFixed            Boolean                @default(false)
  userId             String
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  version            Int                    @default(0)
  deletedAt          DateTime? // Soft delete
  accountId          String?
  categoryId         String?
  creditCardId       String?
  invoiceId          String? // FK para CreditCardInvoice (fatura fechada)
  installmentId      String?
  currentInstallment Int?
  installmentCount   Int?
  receiptUrl         String?
  classificationRule Int?                   @map("classification_rule")
  fitId              String?
  sharedWithEmail    String?
  transferGroupId    String? // links paired (Entrada)/(Saida) transfer transactions
  account            Account?               @relation(fields: [accountId], references: [id], onDelete: SetNull)
  category           Category?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  creditCard         CreditCard?            @relation(fields: [creditCardId], references: [id], onDelete: SetNull)
  invoice            CreditCardInvoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  installment        CreditCardInstallment? @relation("CreditCardInstallmentTransactions", fields: [installmentId], references: [id], onDelete: SetNull)
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fitId])
  @@index([userId])
  @@index([date])
  @@index([userId, date])
  @@index([userId, type, date])
  @@index([userId, categoryId, date])
  @@index([userId, deletedAt])
  @@index([accountId])
  @@index([creditCardId])
  @@index([invoiceId])
  @@index([installmentId])
}

model Budget {
  id          String    @id @default(uuid())
  amount      String
  userId      String
  categoryId  String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime? // Soft delete
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryObj Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId])
  @@index([categoryId])
  @@index([userId])
  @@index([userId, deletedAt])
}

model Goal {
  id            String    @id @default(uuid())
  title         String
  targetAmount  String
  currentAmount String    @default("0")
  deadline      DateTime?
  userId        String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime? // Soft delete
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, deletedAt])
}

model ImportedFitId {
  id         String   @id @default(uuid())
  fitId      String
  userId     String
  accountId  String?
  status     String
  importedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fitId])
  @@index([userId])
}

model Feedback {
  id        String   @id @default(uuid())
  content   String
  platform  String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model VerificationToken {
  id        String   @id @default(uuid())
  token     String   @unique
  type      String
  expiresAt DateTime
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model TransactionInvite {
  id                    String   @id @default(uuid())
  amount                String
  description           String
  date                  DateTime
  type                  String
  status                String   @default("PENDING")
  senderId              String
  recipientEmail        String
  recipientId           String?
  originalTransactionId String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  recipient             User?    @relation("ReceivedInvites", fields: [recipientId], references: [id], onDelete: SetNull)
  sender                User     @relation("SentInvites", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([recipientEmail])
  @@index([recipientId])
}

model Notification {
  id         String   @id @default(uuid())
  title      String
  message    String
  type       String
  isRead     Boolean  @default(false)
  userId     String
  metadata   Json?
  actionType String? // CONFIRM_PAYMENT, POSTPONE — for interactive notifications
  actionMeta Json? // { recurringTransactionId, installmentId, amount, description, accountId, categoryId, creditCardId }
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model Subscription {
  id        String    @id @default(uuid())
  userId    String    @unique
  plan      String    @default("free") // free, premium
  status    String    @default("active") // active, past_due, canceled, expired
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  payments Payment[]

  @@index([userId])
}

model Payment {
  id             String   @id @default(uuid())
  userId         String
  subscriptionId String?
  mpPaymentId    String?  @unique // Mercado Pago payment ID
  mpPreferenceId String? // Mercado Pago preference ID
  amount         Float
  currency       String   @default("BRL")
  status         String   @default("pending") // pending, approved, rejected, refunded
  planPurchased  String // free, premium, annual
  paymentMethod  String? // pix, credit_card, debit_card
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([userId])
  @@index([mpPaymentId])
  @@index([status])
}

model AiRequestLog {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model ErrorReport {
  id             Int      @id @default(autoincrement())
  message        String
  stack          String?
  componentStack String?
  platform       String?
  appVersion     String?
  deviceId       String?
  userId         String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([platform])
}

model AuditLog {
  id            String  @id @default(uuid())
  action        String // e.g. "auth.login", "transaction.create", "account.delete"
  actorId       String? // userId who performed the action (null for system actions)
  targetType    String? // e.g. "Transaction", "Account", "User"
  targetId      String? // ID of the affected entity
  previousState Json? // state before mutation (for UPDATE/DELETE)
  newState      Json? // state after mutation (for CREATE/UPDATE)
  details       Json    @default("{}") // arbitrary metadata (IP, user-agent, diff, etc.)
  ip            String? // requester IP address
  userAgent     String? // requester User-Agent
  severity      String  @default("info") // info | warn | critical
  // Hash chain: SHA256(id + action + actorId + targetId + previousHash + createdAt)
  previousHash  String? // hash of the previous AuditLog entry
  hash          String // SHA-256 of this entry — computed on insert, immutable

  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@index([severity])
}

model RecurringTransaction {
  id           String   @id @default(uuid())
  description  String
  amount       String
  type         String // INCOME, EXPENSE
  categoryId   String?
  accountId    String?
  creditCardId String?
  dueDay       Int // 1-31
  startMonth   Int      @default(1)
  endMonth     Int? // null = indefinido
  isActive     Boolean  @default(true)
  userId       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  account    Account?    @relation(fields: [accountId], references: [id], onDelete: SetNull)
  creditCard CreditCard? @relation(fields: [creditCardId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, isActive])
}

model CreditCardInstallment {
  id                 String   @id @default(uuid())
  description        String
  totalAmount        String
  installmentCount   Int
  currentInstallment Int      @default(0)
  amountPerMonth     String
  entryAmount        String? // valor da entrada (null = sem entrada)
  startDate          DateTime
  dueDay             Int // 1-31
  isActive           Boolean  @default(true)
  accountId          String? // conta que será debitada
  creditCardId       String
  categoryId         String?
  userId             String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditCard   CreditCard    @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  account      Account?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  transactions Transaction[] @relation("CreditCardInstallmentTransactions")

  @@index([userId])
  @@index([creditCardId])
  @@index([isActive])
}

model CreditCardInvoice {
  id             String    @id @default(uuid())
  creditCardId   String
  referenceMonth Int // 1-12, mês de referência da fatura
  referenceYear  Int // ano de referência da fatura
  closingDate    DateTime // data de fechamento da fatura (baseada no closingDay)
  dueDate        DateTime // data de vencimento da fatura (baseada no dueDay)
  totalAmount    String    @default("0") // soma das transações do período
  paidAmount     String    @default("0") // valor já pago (registro parcial/total)
  isPaid         Boolean   @default(false) // fatura foi quitada?
  paidAt         DateTime? // data do pagamento total
  userId         String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  creditCard   CreditCard    @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[] // transações vinculadas a esta fatura

  @@unique([creditCardId, referenceMonth, referenceYear]) // um cartão só tem uma fatura por mês/ano
  @@index([userId])
  @@index([creditCardId])
  @@index([creditCardId, isPaid])
}

// Pilar 1: Refresh Token Rotation — token family pattern (RFC 6819)
model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  familyId  String // Groups tokens from same login session
  tokenHash String // SHA-256 hash of the refresh token
  active    Boolean  @default(true) // false = already rotated or revoked
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tokenHash])
  @@index([userId])
  @@index([userId, familyId])
  @@index([expiresAt])
}

model Reseller {
  id                  String    @id @default(uuid())
  email               String    @unique
  password            String
  displayName         String
  companyName         String?
  phone               String?
  notes               String?
  status              String    @default("active") // active, suspended, disabled
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  hashedRefreshToken  String?
  creditVersion       Int       @default(0)
  lastLoginAt         DateTime?
  createdByAdminId    String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  createdByAdmin     User?                       @relation("ResellerCreatedByAdmin", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  ledgerEntries      ResellerLedger[]
  premiumActivations ResellerPremiumActivation[]

  @@index([status])
  @@index([createdByAdminId])
  @@index([createdAt])
}

model ResellerLedger {
  id               String   @id @default(uuid())
  resellerId       String
  entryType        String // credit_grant, premium_activation, adjustment_credit, adjustment_debit
  deltaCredits     Int
  balanceAfter     Int
  reason           String
  notes            String
  referenceType    String?
  referenceId      String?
  idempotencyKey   String?  @unique
  metadata         Json     @default("{}")
  createdByAdminId String?
  createdAt        DateTime @default(now())

  reseller       Reseller @relation(fields: [resellerId], references: [id], onDelete: Cascade)
  createdByAdmin User?    @relation("ResellerLedgerCreatedByAdmin", fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@index([resellerId, createdAt])
  @@index([entryType])
  @@index([referenceType, referenceId])
  @@index([createdByAdminId])
}

model ResellerPremiumActivation {
  id                      String   @id @default(uuid())
  resellerId              String
  targetUserId            String
  targetUserEmailSnapshot String
  targetUserNameSnapshot  String?
  lookupEmail             String
  sku                     String // premium_monthly_credit, premium_quarterly_credit, premium_semiannual_credit, premium_annual_credit
  creditsConsumed         Int
  durationDays            Int
  startsAt                DateTime
  expiresAt               DateTime
  idempotencyKey          String   @unique
  createdAt               DateTime @default(now())

  reseller   Reseller @relation(fields: [resellerId], references: [id], onDelete: Cascade)
  targetUser User     @relation("ResellerPremiumActivationTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([resellerId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([sku])
}
