generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                     String                  @id @default(uuid())
  email                  String                  @unique
  password               String
  name                   String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  isAdmin                Boolean                 @default(false)
  isEmailVerified        Boolean                 @default(false)
  hashedRefreshToken     String?
  failedLoginAttempts    Int                     @default(0)
  lockedUntil            DateTime?
  termsAccepted          Boolean                 @default(false)
  termsAcceptedAt        DateTime?
  accounts               Account[]
  budgets                Budget[]
  categories             Category[]
  creditCards            CreditCard[]
  feedbacks              Feedback[]
  goals                  Goal[]
  importedFitIds         ImportedFitId[]
  notifications          Notification[]
  transactions           Transaction[]
  receivedInvites        TransactionInvite[]     @relation("ReceivedInvites")
  sentInvites            TransactionInvite[]     @relation("SentInvites")
  verificationTokens     VerificationToken[]
  subscription           Subscription?
  aiRequestLogs          AiRequestLog[]
  auditLogs              AuditLog[]
  recurringTransactions  RecurringTransaction[]
  creditCardInstallments CreditCardInstallment[]
  creditCardInvoices    CreditCardInvoice[]
}

model Account {
  id                     String                  @id @default(uuid())
  name                   String
  type                   String
  balance                Decimal                 @default(0) @db.Decimal(15, 2)
  userId                 String
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  deletedAt              DateTime? // Soft delete
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditCards            CreditCard[]
  transactions           Transaction[]
  recurringTransactions  RecurringTransaction[]
  creditCardInstallments CreditCardInstallment[]

  @@index([userId])
  @@index([userId, deletedAt])
}

model CreditCard {
  id                   String                  @id @default(uuid())
  name                 String
  limit                Decimal                 @db.Decimal(15, 2)
  closingDay           Int
  dueDay               Int
  accountId            String?
  userId               String
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  deletedAt            DateTime? // Soft delete
  account              Account?                @relation(fields: [accountId], references: [id], onDelete: SetNull)
  user                 User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions         Transaction[]
  invoices             CreditCardInvoice[]
  installments         CreditCardInstallment[]
  RecurringTransaction RecurringTransaction[]

  @@index([userId])
  @@index([userId, deletedAt])
  @@index([accountId])
}

model Category {
  id                     String                  @id @default(uuid())
  name                   String
  color                  String?
  icon                   String?
  type                   String
  userId                 String
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  deletedAt              DateTime? // Soft delete
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions           Transaction[]
  budgets                Budget[]
  recurringTransactions  RecurringTransaction[]
  creditCardInstallments CreditCardInstallment[]

  @@index([userId])
  @@index([userId, deletedAt])
}

model Transaction {
  id                 String      @id @default(uuid())
  description        String
  amount             Decimal     @db.Decimal(15, 2)
  date               DateTime
  categoryLegacy     String?     @map("category")
  type               String
  isFixed            Boolean     @default(false)
  userId             String
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  deletedAt          DateTime? // Soft delete
  accountId          String?
  categoryId         String?
  creditCardId       String?
  invoiceId          String? // FK para CreditCardInvoice (fatura fechada)
  currentInstallment Int?
  installmentCount   Int?
  receiptUrl         String?
  classificationRule Int?        @map("classification_rule")
  fitId              String?
  sharedWithEmail    String?
  transferGroupId    String?     // links paired (Entrada)/(Saida) transfer transactions
  account            Account?    @relation(fields: [accountId], references: [id], onDelete: SetNull)
  category           Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  creditCard         CreditCard? @relation(fields: [creditCardId], references: [id], onDelete: SetNull)
  invoice            CreditCardInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fitId])
  @@index([userId])
  @@index([date])
  @@index([userId, date])
  @@index([userId, type, date])
  @@index([userId, categoryId, date])
  @@index([userId, deletedAt])
  @@index([accountId])
  @@index([creditCardId])
  @@index([invoiceId])
}

model Budget {
  id          String    @id @default(uuid())
  amount      Decimal   @db.Decimal(15, 2)
  userId      String
  categoryId  String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime? // Soft delete
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryObj Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId])
  @@index([categoryId])
  @@index([userId])
  @@index([userId, deletedAt])
}

model Goal {
  id            String    @id @default(uuid())
  title         String
  targetAmount  Decimal   @db.Decimal(15, 2)
  currentAmount Decimal   @default(0) @db.Decimal(15, 2)
  deadline      DateTime?
  userId        String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime? // Soft delete
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, deletedAt])
}

model ImportedFitId {
  id         String   @id @default(uuid())
  fitId      String
  userId     String
  accountId  String?
  status     String
  importedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fitId])
  @@index([userId])
}

model Feedback {
  id        String   @id @default(uuid())
  content   String
  platform  String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model VerificationToken {
  id        String   @id @default(uuid())
  token     String   @unique
  type      String
  expiresAt DateTime
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model TransactionInvite {
  id                    String   @id @default(uuid())
  amount                Decimal  @db.Decimal(15, 2)
  description           String
  date                  DateTime
  type                  String
  status                String   @default("PENDING")
  senderId              String
  recipientEmail        String
  recipientId           String?
  originalTransactionId String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  recipient             User?    @relation("ReceivedInvites", fields: [recipientId], references: [id], onDelete: SetNull)
  sender                User     @relation("SentInvites", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([recipientEmail])
  @@index([recipientId])
}

model Notification {
  id         String   @id @default(uuid())
  title      String
  message    String
  type       String
  isRead     Boolean  @default(false)
  userId     String
  metadata   Json?
  actionType String?  // CONFIRM_PAYMENT, POSTPONE — for interactive notifications
  actionMeta Json?    // { recurringTransactionId, installmentId, amount, description, accountId, categoryId, creditCardId }
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model Subscription {
  id        String    @id @default(uuid())
  userId    String    @unique
  plan      String    @default("free") // free, premium
  status    String    @default("active") // active, past_due, canceled, expired
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  payments   Payment[]

  @@index([userId])
}

model Payment {
  id             String   @id @default(uuid())
  userId         String
  subscriptionId String?
  mpPaymentId    String?  @unique  // Mercado Pago payment ID
  mpPreferenceId String?           // Mercado Pago preference ID
  amount         Float
  currency       String   @default("BRL")
  status         String   @default("pending") // pending, approved, rejected, refunded
  planPurchased  String              // free, premium, annual
  paymentMethod  String?            // pix, credit_card, debit_card
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([userId])
  @@index([mpPaymentId])
  @@index([status])
}

model AiRequestLog {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model ErrorReport {
  id             Int      @id @default(autoincrement())
  message        String
  stack          String?
  componentStack String?
  platform       String?
  appVersion     String?
  deviceId       String?
  userId         String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([platform])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  action     String // CREATE, UPDATE, DELETE, IMPORT, TRANSFER, LOGIN, LOGIN_FAILED
  resource   String // Transaction, Account, Budget, Goal, etc
  resourceId String?
  ip         String?
  details    String? // JSON string with change details
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([resource])
  @@index([createdAt])
}

model RecurringTransaction {
  id           String   @id @default(uuid())
  description  String
  amount       Decimal  @db.Decimal(15, 2)
  type         String // INCOME, EXPENSE
  categoryId   String?
  accountId    String?
  creditCardId String?
  dueDay       Int // 1-31
  startMonth   Int      @default(1)
  endMonth     Int? // null = indefinido
  isActive     Boolean  @default(true)
  userId       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  account    Account?    @relation(fields: [accountId], references: [id], onDelete: SetNull)
  creditCard CreditCard? @relation(fields: [creditCardId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, isActive])
}

model CreditCardInstallment {
  id                 String   @id @default(uuid())
  description        String
  totalAmount        Decimal  @db.Decimal(15, 2)
  installmentCount   Int
  currentInstallment Int      @default(0)
  amountPerMonth     Decimal  @db.Decimal(15, 2)
  entryAmount        Decimal? @db.Decimal(15, 2) // valor da entrada (null = sem entrada)
  startDate          DateTime
  dueDay             Int // 1-31
  isActive           Boolean  @default(true)
  accountId          String? // conta que será debitada
  creditCardId       String
  categoryId         String?
  userId             String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditCard CreditCard @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  account    Account?   @relation(fields: [accountId], references: [id], onDelete: SetNull)
  category   Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([creditCardId])
  @@index([isActive])
}

model CreditCardInvoice {
  id             String   @id @default(uuid())
  creditCardId   String
  referenceMonth Int // 1-12, mês de referência da fatura
  referenceYear  Int // ano de referência da fatura
  closingDate    DateTime // data de fechamento da fatura (baseada no closingDay)
  dueDate        DateTime // data de vencimento da fatura (baseada no dueDay)
  totalAmount    Decimal  @default(0) @db.Decimal(15, 2) // soma das transações do período
  paidAmount     Decimal  @default(0) @db.Decimal(15, 2) // valor já pago (registro parcial/total)
  isPaid         Boolean  @default(false) // fatura foi quitada?
  paidAt         DateTime? // data do pagamento total
  userId         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  creditCard   CreditCard    @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[] // transações vinculadas a esta fatura

  @@unique([creditCardId, referenceMonth, referenceYear]) // um cartão só tem uma fatura por mês/ano
  @@index([userId])
  @@index([creditCardId])
  @@index([creditCardId, isPaid])
}
